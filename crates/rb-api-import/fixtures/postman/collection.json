{
  "info": {
    "_postman_id": "0b7c1a2e-0000-4000-8000-000000000001",
    "name": "Shop API",
    "description": "The shop's API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('t', Date.now());"] } }
  ],
  "variable": [
    { "key": "apiVersion", "value": "v2" },
    { "key": "adminPassword", "value": "hunter2" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "debug", "value": "true", "disabled": true }
              ]
            },
            "description": "Every user, a page at a time."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }
          ],
          "response": [{ "name": "200", "status": "OK", "code": 200, "body": "[]" }]
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "42" }]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin" }, { "key": "password", "value": "s3cret" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ada\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "username", "value": "ada" },
            { "key": "password", "value": "pw" },
            { "key": "remember", "value": "1", "disabled": true }
          ]
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Upload avatar",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Me", "type": "text" },
            { "key": "file", "type": "file", "src": "/home/ada/avatar.png" }
          ]
        },
        "url": "{{baseUrl}}/avatar"
      }
    },
    {
      "name": "Search",
      "protocolProfileBehavior": { "followRedirects": false, "strictSSL": false, "disableCookies": true },
      "request": {
        "auth": { "type": "awsv4", "awsv4": [{ "key": "accessKey", "value": "AKIA" }] },
        "method": "POST",
        "body": { "mode": "graphql", "graphql": { "query": "{ users { id } }", "variables": "{\"first\": 2}" } },
        "url": "{{baseUrl}}/graphql?api_key=k3y"
      }
    }
  ]
}
