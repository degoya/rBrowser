meta {
  name: List users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users?page=1
  body: none
  auth: inherit
}

params:query {
  page: 1
  ~debug: true
}

headers {
  Accept: application/json
  ~X-Trace: 1
}

assert {
  res.status: eq 200
}

tests {
  test("ok", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Every user of the library.
}
