{
  "version": 1,
  "note": "The schema.org types the Microdata and RDFa rules know (RB-080-11) - the common ones, not the whole vocabulary, so an unknown type is a hint, never an error - and the properties the common rich-result types need: all (each one) and any (at least one of each list). Raise version when a value changes.",
  "types": [
    "AboutPage", "AggregateOffer", "AggregateRating", "Answer", "Apartment", "Article",
    "Audience", "AudioObject", "Bakery", "BarOrPub", "Blog", "BlogPosting", "Book",
    "Brand", "BreadcrumbList", "BroadcastEvent", "BusinessEvent", "CafeOrCoffeeShop",
    "Car", "CheckoutPage", "Claim", "ClaimReview", "CollectionPage", "Comment",
    "ContactPage", "ContactPoint", "Corporation", "Country", "Course", "CourseInstance",
    "CreativeWork", "CreativeWorkSeries", "DataCatalog", "DataDownload", "Dataset",
    "DefinedTerm", "DefinedTermSet", "Demand", "Dentist", "DigitalDocument", "Duration",
    "EducationEvent", "EducationalOccupationalCredential", "EducationalOrganization",
    "EmployerAggregateRating", "Episode", "Event", "EventSeries", "FAQPage",
    "FinancialService", "FoodEstablishment", "GeoCoordinates", "GeoShape", "HealthAndBeautyBusiness",
    "HowTo", "HowToDirection", "HowToSection", "HowToStep", "HowToSupply", "HowToTip",
    "HowToTool", "Hotel", "HotelRoom", "House", "ImageGallery", "ImageObject",
    "IndividualProduct", "Intangible", "ItemList", "ItemPage", "JobPosting",
    "LearningResource", "LegalService", "ListItem", "LiveBlogPosting", "LocalBusiness",
    "LodgingBusiness", "MediaObject", "MedicalBusiness", "MedicalOrganization", "MemberProgram",
    "MemberProgramTier", "Menu", "MenuItem", "MenuSection", "MerchantReturnPolicy",
    "MobileApplication", "MonetaryAmount", "Movie", "MusicAlbum", "MusicEvent", "MusicGroup",
    "MusicPlaylist", "MusicRecording", "NewsArticle", "NewsMediaOrganization", "NGO",
    "Occupation", "Offer", "OfferCatalog", "OfferShippingDetails", "OnlineBusiness", "OnlineStore",
    "OpeningHoursSpecification", "Organization", "Person", "Physician", "Place",
    "PodcastEpisode", "PodcastSeries", "PostalAddress", "PriceSpecification", "Product",
    "ProductGroup", "ProductModel", "ProfilePage", "PropertyValue", "QAPage",
    "QuantitativeValue", "Question", "Quiz", "Rating", "Recipe", "Report", "Reservation",
    "Restaurant", "Review", "Role", "SaleEvent", "ScholarlyArticle", "SearchAction",
    "SearchResultsPage", "Service", "ShippingDeliveryTime", "SiteNavigationElement",
    "SocialMediaPosting", "SoftwareApplication", "SoftwareSourceCode", "SpeakableSpecification",
    "SportsEvent", "SportsOrganization", "SportsTeam", "Store", "TechArticle", "TheaterEvent",
    "Thing", "Ticket", "TouristAttraction", "TouristDestination", "TVEpisode", "TVSeries",
    "UnitPriceSpecification", "VacationRental", "Vehicle", "VideoGame", "VideoObject",
    "VirtualLocation", "WPFooter", "WPHeader", "WPSideBar", "WebApplication", "WebPage",
    "WebPageElement", "WebSite"
  ],
  "required": {
    "Product": { "all": ["name"], "any": [["offers", "review", "aggregateRating"]] },
    "Article": { "all": ["headline"] },
    "NewsArticle": { "all": ["headline"] },
    "BlogPosting": { "all": ["headline"] },
    "BreadcrumbList": { "all": ["itemListElement"] },
    "ListItem": { "all": ["position"], "any": [["name", "item"]] },
    "Organization": { "all": ["name"] },
    "FAQPage": { "all": ["mainEntity"] },
    "Question": { "all": ["name", "acceptedAnswer"] },
    "Answer": { "all": ["text"] }
  }
}
