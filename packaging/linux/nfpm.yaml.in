# The deb and rpm packages of rBrowser (RB-097-05), for nfpm. Rendered by
# scripts/package-deb-rpm.sh from a Linux release tarball, once per format: @STAGE@ is the
# unpacked tarball without its sandbox helper, @HELPER@ the helper itself, @KIND_FILE@ the
# install-kind marker naming the format, @ICONS@ the hicolor renderings of the app icon,
# @PACKAGING@ this folder. Change this template, not a rendered copy. Adapted from rCommander's
# packaging/linux/nfpm.yaml.in.
#
# The program lives in /usr/lib/rbrowser with CEF, Node, the sidecar and the bundled plugins
# beside it, and is linked into /usr/bin (it finds libcef.so through its RUNPATH $ORIGIN, which
# the loader resolves through the link). chrome-sandbox, Chromium's sandbox helper, is root's and
# setuid (04755) - the sandbox where the kernel refuses unprivileged user namespaces, as Ubuntu's
# AppArmor does since 23.10. The install-kind marker tells the update check that apt or dnf
# updates it. The data never lives here: settings, profiles and logs are in the user's folders
# (~/.config/rbrowser, ~/.local/state/rBrowser), which no maintainer script touches.
#
# Dependencies: the NEEDED entries of CEF 156's libcef.so (readelf -d) and of rbrowser, built on
# Ubuntu 24.04 (glibc 2.39), each with its pre-t64 name as the alternative (Debian 12). GTK (the
# file dialogs) and the fonts are recommended: Chromium opens GTK at run time when it is there.
name: rbrowser
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
version_schema: semver
section: web
priority: optional
maintainer: DEGOYA.digital
description: |-
  Development browser that shows every breakpoint of a site at once
  rBrowser shows a site at every breakpoint side by side in one window, with navigation,
  scrolling, clicks and input synchronised across the views. DevTools stay usable, and an
  MCP server and a Playwright endpoint let AI agents and tests drive it.
vendor: DEGOYA.digital
homepage: https://github.com/degoya/rBrowser
license: GPL-3.0-or-later

depends:
  - libc6 (>= 2.39)
  - libgcc-s1
  - libglib2.0-0t64 | libglib2.0-0
  - libnspr4
  - libnss3
  - libatk1.0-0t64 | libatk1.0-0
  - libatk-bridge2.0-0t64 | libatk-bridge2.0-0
  - libatspi2.0-0t64 | libatspi2.0-0
  - libcups2t64 | libcups2
  - libdbus-1-3
  - libx11-6
  - libxcb1
  - libxcomposite1
  - libxdamage1
  - libxext6
  - libxfixes3
  - libxrandr2
  - libxkbcommon0
  - libgbm1
  - libexpat1
  - libcairo2
  - libpango-1.0-0
  - libudev1
  - libasound2t64 | libasound2
recommends:
  - libgtk-3-0t64 | libgtk-3-0
  - fonts-liberation
  - xdg-utils
overrides:
  rpm:
    depends:
      - glibc >= 2.39
      - libgcc
      - glib2
      - nspr
      - nss
      - atk
      - at-spi2-atk
      - at-spi2-core
      - cups-libs
      - dbus-libs
      - libX11
      - libxcb
      - libXcomposite
      - libXdamage
      - libXext
      - libXfixes
      - libXrandr
      - libxkbcommon
      - mesa-libgbm
      - expat
      - cairo
      - pango
      - systemd-libs
      - alsa-lib
    recommends:
      - gtk3
      - liberation-fonts
      - xdg-utils

contents:
  # The tree names /usr/lib/rbrowser itself (its "."), so the package owns the folder and
  # removing the rpm takes it along: rpm removes only the directories a package names, where
  # dpkg also drops one it created and left empty. A separate `type: dir` entry for it collides
  # with the tree's own (nfpm: "content collision").
  - src: "@STAGE@"
    dst: /usr/lib/rbrowser
    type: tree
  - src: "@HELPER@"
    dst: /usr/lib/rbrowser/chrome-sandbox
    file_info:
      mode: 04755
      owner: root
      group: root
  - src: "@KIND_FILE@"
    dst: /usr/lib/rbrowser/install-kind
    file_info:
      mode: 0644
  - src: /usr/lib/rbrowser/rbrowser
    dst: /usr/bin/rbrowser
    type: symlink
  - src: "@PACKAGING@/rbrowser.desktop"
    dst: /usr/share/applications/rbrowser.desktop
    file_info:
      mode: 0644
  - src: "@ICONS@/rbrowser.svg"
    dst: /usr/share/icons/hicolor/scalable/apps/rbrowser.svg
    file_info:
      mode: 0644
  - src: "@ICONS@/48/rbrowser.png"
    dst: /usr/share/icons/hicolor/48x48/apps/rbrowser.png
    file_info:
      mode: 0644
  - src: "@ICONS@/128/rbrowser.png"
    dst: /usr/share/icons/hicolor/128x128/apps/rbrowser.png
    file_info:
      mode: 0644
  - src: "@ICONS@/256/rbrowser.png"
    dst: /usr/share/icons/hicolor/256x256/apps/rbrowser.png
    file_info:
      mode: 0644
  - src: "@STAGE@/LICENSE"
    dst: /usr/share/doc/rbrowser/copyright
    file_info:
      mode: 0644
